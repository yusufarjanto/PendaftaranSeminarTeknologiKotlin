<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="#EAF4FF"
    tools:targetApi="36"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER SEMINAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="28dp"
            android:background="#083F7D">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/seminar_teknologi_2026"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/future_of_ai_amp_digital_innovation"
                android:textSize="15sp"
                android:textColor="#C9E9FF"
                android:gravity="center"/>

        </LinearLayout>

        <!-- FORM PENDAFTARAN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/form_pendaftaran"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#083F7D"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/nama_lengkap"
                android:textColor="#333333"
                android:textSize="15sp"/>

            <EditText
                android:id="@+id/etNama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/masukkan_nama_lengkap"
                android:importantForAutofill="no"
                android:inputType="textPersonName"
                android:textSize="16sp"
                android:minHeight="48dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/usia_umur"
                android:textColor="#333333"
                android:textSize="15sp"/>

            <EditText
                android:id="@+id/etUsia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/masukkan_usia"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="3"
                android:textSize="16sp"
                android:minHeight="48dp"/>

            <Button
                android:id="@+id/btnKirim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/kirim_data_ke_form"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0877C9"/>

            <Button
                android:id="@+id/btnInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/buka_info_event"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#083F7D"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/seminar_teknologi_registration_app"
            android:gravity="center"
            android:textColor="#607D98"
            android:textSize="12sp"/>

    </LinearLayout>

</ScrollView>
